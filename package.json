{
	"name": "verdigris",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"description": "Verdigris: an intimate liquid puzzle game on svelte-fluid's air and liquid engines.",
	"license": "MIT",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"test:browser": "VITEST_BROWSER=1 vitest run --project browser"
	},
	"dependencies": {
		"svelte-fluid": "^1.1.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.1",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@vitest/browser": "^4.1.10",
		"@vitest/browser-playwright": "^4.1.10",
		"playwright": "^1.61.1",
		"svelte": "^5.56.7",
		"svelte-check": "^4.7.3",
		"typescript": "^5.9.3",
		"vite": "^7.3.6",
		"vitest": "^4.1.10"
	}
}
